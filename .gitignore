# ============================================================
# 学员隐私数据 —— 绝对不能进仓库
# Student PII — must never be committed
# ============================================================
# 教务导出的表格含真实姓名、家长手机号、住址
# Exported spreadsheets contain real names, parent phone numbers, addresses
*.xls
*.xlsx
*.csv

# 运行数据：数据库、学员照片、语音录音、自签证书私钥、会话密钥
# Runtime data: database, student photos, voice recordings, TLS private key
/data/
/backups/

# ============================================================
# 构建产物与依赖 —— 不进仓库，按 README 自行构建
# Build output and dependencies — rebuild per README
# ============================================================
/dist/
/build/
/installer_output/
*.spec.bak
.venv/
venv/
env/
node_modules/

# 语音模型 228MB，用 install_asr.py 下载
# ASR model is 228MB, fetch via install_asr.py
**/models/

